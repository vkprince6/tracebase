rules_version = '2';

/**
 * TRACEBASE — Firestore Security Rules
 * -------------------------------------------------------
 * Enforces role-based access control server-side. The frontend JavaScript
 * never grants access on its own — every read/write is re-checked here.
 *
 * Roles (stored on /users/{uid}.role):
 *   admin     - full access to everything
 *   reporter  - manager-level: create/assign tasks, manage projects, view all
 *   assignee  - can only update their own assigned tasks' work fields
 *
 * Deploy with: firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- Helpers ---------------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function isActiveUser() {
      return isSignedIn() &&
             currentUserDoc().exists() &&
             currentUserData().active == true;
    }

    function role() {
      return currentUserData().role;
    }

    function isAdmin() {
      return isActiveUser() && role() == 'admin';
    }

    function isReporter() {
      return isActiveUser() && role() == 'reporter';
    }

    function isManagerOrAbove() {
      return isAdmin() || isReporter();
    }

    function isAssignee() {
      return isActiveUser() && role() == 'assignee';
    }

    /* Only a whitelisted set of fields may change — used to stop an
       assignee from editing fields they should not control. */
    function onlyChangedFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedFields);
    }

    /* ---------------- users ---------------- */
    match /users/{userId} {
      // Anyone signed in can read user profiles (names/avatars needed across the app).
      allow read: if isSignedIn();

      // A user may create their own profile document only once, during first setup,
      // matching their own uid, and must not self-assign the admin role.
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       request.resource.data.role != 'admin';

      // Admins can fully manage any user (role, active status, details).
      allow update, delete: if isAdmin();

      // Users may update a limited set of their own profile fields
      // (never their own role or active status).
      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       onlyChangedFields(['name', 'department', 'designation', 'profilePhoto', 'updatedAt']);
    }

    /* ---------------- projects ---------------- */
    match /projects/{projectDoc} {
      allow read: if isActiveUser();
      allow create, update: if isManagerOrAbove();
      allow delete: if isAdmin();
    }

    /* ---------------- tasks ---------------- */
    match /tasks/{taskDoc} {
      allow read: if isActiveUser();

      // Managers/admins can create and fully edit any task.
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isAdmin();

      // An assignee may only update their OWN task, and only work-related fields:
      // status, progress, actualHours, remainingHours, links, tags, updatedAt, completedAt.
      allow update: if isAssignee() &&
                       resource.data.assigneeId == request.auth.uid &&
                       onlyChangedFields([
                         'status', 'progress', 'actualHours', 'remainingHours',
                         'links', 'updatedAt', 'completedAt'
                       ]);
    }

    /* ---------------- comments ---------------- */
    match /comments/{commentDoc} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      // Only the comment's author may edit or delete it; admins may moderate/delete any comment.
      allow update: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isActiveUser() && resource.data.userId == request.auth.uid);
    }

    /* ---------------- activity ---------------- */
    match /activity/{activityDoc} {
      allow read: if isActiveUser();
      // Activity entries are append-only system logs generated by the app on behalf
      // of the signed-in user; they are never edited or deleted by clients.
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------------- notifications ---------------- */
    match /notifications/{notifDoc} {
      // A user may only read their own notifications.
      allow read: if isActiveUser() && resource.data.userId == request.auth.uid;
      // Any active user may create a notification addressed to someone else
      // (e.g. assigning a task creates a notification for the assignee).
      allow create: if isActiveUser();
      // A user may only mark their own notification read (limited field change).
      allow update: if isActiveUser() &&
                       resource.data.userId == request.auth.uid &&
                       onlyChangedFields(['read']);
      allow delete: if isActiveUser() && resource.data.userId == request.auth.uid;
    }

    /* ---------------- tags / settings (optional collections) ---------------- */
    match /tags/{tagDoc} {
      allow read: if isActiveUser();
      allow write: if isManagerOrAbove();
    }
    match /settings/{settingDoc} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    /* Deny everything else by default. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
